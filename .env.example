# App settings
APP_ENV=development
APP_NAME="Medical RAG Engine"
DEBUG=true

# LLM & Embeddings Provider (ollama | openai | vllm | openai_compatible)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- 1. MODO LOCAL (Ollama - Costo cero de tokens) ---
OLLAMA_BASE_URL=http://192.168.3.4:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.0

# --- 2. MODO PRODUCCIÓN / CLÚSTER (vLLM / Triton / Groq / DeepSeek / On-Premise GPUs) ---
CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
CUSTOM_LLM_API_KEY=EMPTY
CUSTOM_LLM_MODEL=llama-3.1-70b-instruct
CUSTOM_LLM_TEMPERATURE=0.0

CUSTOM_EMBED_BASE_URL=http://localhost:8000/v1
CUSTOM_EMBED_API_KEY=EMPTY
CUSTOM_EMBED_MODEL=bge-m3

# --- 3. MODO NUBE OFICIAL (OpenAI Fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- VECTOR STORE (elasticsearch | chroma) ---
VECTOR_STORE_BACKEND=elasticsearch

# Elasticsearch (Local Docker o Clúster Productivo con Auth)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=clinical_docs
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL_VERIFY=false

# RAG & Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
